# PRAMAAN-AICTE Environment Configuration Example

# Project Settings
PROJECT_NAME="PRAMAAN-AICTE"
VERSION="1.0.0"

# Security & Session Secrets
SECRET_KEY="replace_with_secure_random_production_secret_key"
HMAC_APAAR_KEY="replace_with_confidential_salt_for_apaar_identifier_hashing"

# Database Configuration (SQLite default for zero-setup local dev; PostgreSQL supported)
DATABASE_URL="sqlite:///./pramaan.db"
# DATABASE_URL="postgresql://pramaan_user:pramaan_secure_password@localhost:5432/pramaan_db"

# Storage
UPLOAD_STORAGE_DIR="./storage/uploads"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
